# ────────────────────────────────────────────────────────────────────────
# Local stack — ports and auth mode
# ────────────────────────────────────────────────────────────────────────
#
# Copy to `.env` at the repo root and change only what clashes on your machine ; every value below
# is already the default, so the file is optional. The usual case is a local Postgres holding 5432.

# Exposed on the host ; the container stays on 5432 internally.
POSTGRES_HOST_PORT=5432

# Run natively by Tilt, not in a container.
BACKEND_HOST_PORT=8080

FRONTEND_HOST_PORT=4200

# Tilt resource disabled by default — start it from the Tilt UI when working on the lib.
STORYBOOK_HOST_PORT=6006

# ────────────────────────────────────────────────────────────────────────
# Auth mode — picks the Spring profiles the Tiltfile launches with
# ────────────────────────────────────────────────────────────────────────
#
#   no-auth (default) — Spring Security is bypassed, a fake ADMIN user is seeded at boot.
#   oauth             — the real Google flow against localhost. Needs the credentials below, your
#                       email in APP_ADMIN_EMAILS, and an OAuth client registered with
#                       `http://localhost:<FRONTEND_HOST_PORT>/login/oauth2/code/google` as its
#                       redirect URI (the SPA's port, not the backend's — the CLI proxy forwards
#                       with xfwd).
#
# The Tilt panel of the `backend` resource has buttons that flip this value and restart.
BACKEND_AUTH_MODE=no-auth

# ────────────────────────────────────────────────────────────────────────
# Boot-time secrets — only what cannot be edited from the UI
# ────────────────────────────────────────────────────────────────────────
#
# Spring builds its `ClientRegistrationRepository` at boot, so the Google credentials have to be
# there at startup and cannot be changed without a restart.

# **Leave these commented out in no-auth mode.** An env var set to an empty string is not the same
# as an unset one : exported empty, Spring tries to build a Google registration with an empty
# client-id and crashes at boot.
#SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
#SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=

# Emails that land with the ADMIN role at their first login. Comma-separated, case-insensitive. The
# role is frozen at user creation ; changing it afterwards is a SQL update.
APP_ADMIN_EMAILS=

# Where the post-login redirect goes. Needed in dev only, where the SPA has its own port : keep it
# in sync with FRONTEND_HOST_PORT above, or the login lands on the backend instead of the app.
# Never set it to an empty string — `defaultSuccessUrl("")` crashes at startup ; comment the whole
# line out instead.
APP_FRONTEND_URL=http://localhost:4200/
