{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prepare": "node -e \"try { require('child_process').execSync('git config core.hooksPath .githooks', { stdio: 'ignore' }) } catch {}\"",
    "prestart": "node apps/web/tools/copy-docs.mjs",
    "start": "ng serve web",
    "prebuild": "node apps/web/tools/copy-docs.mjs",
    "build": "ng build web",
    "prewatch": "node apps/web/tools/copy-docs.mjs",
    "watch": "ng build web --watch --configuration development",
    "test": "ng test web",
    "test:coverage": "ng test web --configuration=coverage",
    "e2e": "playwright test -c apps/web-e2e/playwright.config.ts",
    "e2e:open": "playwright test -c apps/web-e2e/playwright.config.ts --ui",
    "lint": "ng lint web && ng lint ui",
    "web:check-a11y": "node apps/web/tools/check-icon-button-names.mjs",
    "docs:check-sync": "node apps/web/tools/check-docs-sync.mjs",
    "format": "prettier --write \"{apps,libs}/**/*.{ts,html,scss}\"",
    "ui:build": "ng build ui",
    "ui:test": "ng test ui",
    "ui:lint": "ng lint ui",
    "ui:check-peers": "node libs/ui/tools/check-peers.mjs",
    "ui:check-contrast": "node libs/ui/tools/check-contrast.mjs",
    "storybook": "ng run ui:storybook",
    "storybook:build": "ng run ui:build-storybook"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@sentry/browser": "^10.75.3",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "marked": "^18.0.14",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.1",
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/angular": "^10.6.1",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "22.5.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "ng-packagr": "^22.2.4",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "storybook": "^10.6.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "^4.1.11"
  }
}
